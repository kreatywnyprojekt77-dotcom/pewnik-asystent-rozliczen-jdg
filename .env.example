# Skopiuj ten plik jako .env i uzupełnij wyłącznie lokalnie.
# W repozytorium pozostają tylko nazwy zmiennych i bezpieczne atrapy wartości.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Nigdy nie umieszczaj tutaj ani w kodzie frontendu:
# - SUPABASE_SERVICE_ROLE_KEY,
# - hasła do bazy danych,
# - prywatnego klucza dostawcy LLM.
# Sekrety serwerowe powinny być używane wyłącznie po stronie backendu.
